<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AI_Smart_Teacher</AssemblyName>
    <RootNamespace>AI_Smart_Teacher.Desktop</RootNamespace>
    <ApplicationTitle>AI Smart Teacher</ApplicationTitle>
    <Product>AI Smart Teacher</Product>
    <Company>AI Smart Teacher</Company>
    <Description>AI Smart Teacher - تعلم أذكى، مستقبل أفضل</Description>
    <LangVersion>latest</LangVersion>
    <Version>0.9.0</Version>
    <FileVersion>0.9.0.0</FileVersion>
    <AssemblyVersion>0.9.0.0</AssemblyVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AI_Smart_Teacher.Core\AI_Smart_Teacher.Core.csproj" />
    <ProjectReference Include="..\AI_Smart_Teacher.Application\AI_Smart_Teacher.Application.csproj" />
    <ProjectReference Include="..\AI_Smart_Teacher.Infrastructure\AI_Smart_Teacher.Infrastructure.csproj" />
    <ProjectReference Include="..\AI_Smart_Teacher.Data\AI_Smart_Teacher.Data.csproj" />
    <ProjectReference Include="..\AI_Smart_Teacher.AI\AI_Smart_Teacher.AI.csproj" />
    <ProjectReference Include="..\AI_Smart_Teacher.Vision\AI_Smart_Teacher.Vision.csproj" />
    <ProjectReference Include="..\AI_Smart_Teacher.Voice\AI_Smart_Teacher.Voice.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>
</Project>
